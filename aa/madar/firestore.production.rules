rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed() { return request.auth != null; }
  function role() { return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role; }
  function admin() { return signed() && role() == 'admin'; }
  function member(pid) { return signed() && request.auth.uid in get(/databases/$(database)/documents/projects/$(pid)).data.members; }
  function review(pid) { return admin() || (signed() && (role() == 'committee' || (role() == 'doctor' && member(pid)))); }
  match /profiles/{uid} {
   allow read: if signed();
   allow create: if signed() && request.auth.uid == uid && request.resource.data.role in ['student','doctor'] && request.resource.data.username.matches('^[a-z][a-z0-9_]{2,23}$') && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid;
   allow update: if admin() || (signed() && request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','createdAt','id']));
  }
  match /usernames/{username} {
   allow get: if signed();
   allow create: if signed() && request.resource.data.uid == request.auth.uid && username.matches('^[a-z][a-z0-9_]{2,23}$');
  }
  // Academic project records are institution-visible to authenticated accounts.
  // The UI limits the workspace to assigned projects; this is not record-level read isolation.
  match /projects/{id} {
   allow read: if signed();
   allow create: if signed() && request.resource.data.ownerId == request.auth.uid && request.auth.uid in request.resource.data.members;
   allow update: if admin() || (signed() && (resource.data.ownerId == request.auth.uid || resource.data.supervisorId == request.auth.uid || role() == 'committee') && request.resource.data.ownerId == resource.data.ownerId);
  }
  match /tasks/{id} {
   allow read: if signed();
   allow create: if member(request.resource.data.projectId) || admin();
   allow update: if (member(resource.data.projectId) || admin()) && request.resource.data.projectId == resource.data.projectId;
   allow delete: if member(resource.data.projectId) || admin();
  }
  match /events/{id} {
   allow read: if signed();
   allow create: if member(request.resource.data.projectId) || admin();
   allow delete: if member(resource.data.projectId) || admin();
  }
  match /comments/{id} {
   allow read: if signed();
   allow create: if signed() && request.resource.data.authorId == request.auth.uid && (member(request.resource.data.projectId) || admin());
  }
  match /submissions/{id} {
   allow read: if signed();
   allow create: if signed() && request.resource.data.authorId == request.auth.uid && request.resource.data.status == 'pending' && (member(request.resource.data.projectId) || admin());
   allow update: if review(resource.data.projectId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','createdAt','id']);
  }
  match /evaluations/{id} {
   allow read: if signed();
   allow create: if signed() && request.resource.data.authorId == request.auth.uid && review(request.resource.data.projectId) && request.resource.data.idea >= 0 && request.resource.data.idea <= 100 && request.resource.data.execution >= 0 && request.resource.data.execution <= 100 && request.resource.data.presentation >= 0 && request.resource.data.presentation <= 100;
  }
  match /messages/{id} {
   allow read: if signed() && request.auth.uid in resource.data.participants;
   allow create: if signed() && request.resource.data.senderId == request.auth.uid && request.resource.data.receiverId != request.auth.uid && request.resource.data.participants.size() == 2 && request.auth.uid in request.resource.data.participants && request.resource.data.receiverId in request.resource.data.participants && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 4000;
  }
  match /announcements/{id} { allow read: if signed(); allow write: if admin(); }
 }
}
